digraph SimpleWorkflow {
    graph [goal="Run a simple greeting workflow"]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    greet [label="Greet", prompt="Generate a friendly greeting message"]
    respond [label="Respond", prompt="Respond to the greeting"]

    start -> greet -> respond -> exit
}
