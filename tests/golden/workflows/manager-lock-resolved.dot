digraph GoldenManagerLockResolved {
  graph [
    goal="Golden regression for manager lock resolved path",
    rankdir=LR,
    golden_seed_context_path="./tests/golden/seed/manager-lock-resolved.json"
  ]

  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare, label="Exit"]

  manager [
    shape=house,
    type="stack.manager_loop",
    label="Manager",
    stack_child_dotfile="./tests/fixtures/reference/simple_example.dot",
    manager_actions="observe",
    manager_poll_interval="0",
    manager_max_cycles="2",
    manager_require_lock="true"
  ]

  start -> manager
  manager -> exit [condition="context.stack.manager_loop.last_child_lock=resolved"]
}
