digraph GoldenFanInConsensus {
  graph [
    goal="Golden regression for fan-in consensus",
    rankdir=LR,
    golden_seed_context_path="./tests/golden/seed/fan_in_consensus.json"
  ]

  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare, label="Exit"]

  fan_in [
    shape=tripleoctagon,
    type="parallel.fan_in",
    label="Fan In",
    merge_strategy="consensus",
    merge_tiebreak="lexical"
  ]

  start -> fan_in -> exit
}
