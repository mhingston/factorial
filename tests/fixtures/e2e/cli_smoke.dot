digraph CliSmoke {
  graph [goal="CLI smoke workflow", rankdir=LR]

  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare, label="Exit"]

  work [
    shape=box,
    label="Work",
    prompt="Emit deterministic CLI output",
    llm_provider="openai",
    llm_model="gpt-test",
    auto_status="true",
    llm_backend="cli",
    cli_command="printf \"$SMOKE_MESSAGE\""
  ]

  start -> work -> exit
}
