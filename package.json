{
  "name": "@mhingston5/factorial",
  "version": "0.1.0",
  "description": "A DOT-based pipeline runner for orchestrating multi-stage AI workflows",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/packages/core/src/index.js",
      "types": "./dist/packages/core/src/index.d.ts"
    },
    "./dot-parser": {
      "import": "./dist/packages/dot-parser/src/index.js",
      "types": "./dist/packages/dot-parser/src/index.d.ts"
    }
  },
  "bin": {
    "factorial": "./dist/packages/cli/src/index.js"
  },
  "scripts": {
    "build": "tsc && cp ./packages/dot-parser/src/parser.js ./dist/packages/dot-parser/src/parser.js",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:golden": "vitest --run tests/golden/golden-regression.test.ts",
    "dtu:run": "npm run build && node ./dist/packages/cli/src/index.js dtu-run --fixtures ./tests/fixtures/dtu/scenarios --report ./reports/dtu_satisfaction_report.json",
    "test:coverage": "vitest --run --coverage",
    "lint": "biome lint .",
    "lint:biome": "biome lint .",
    "format": "biome format --write .",
    "agent:audit": "node ./scripts/agent-capability-audit.js",
    "test:worktree": "node ./scripts/worktree-parity-check.js",
    "check:pr-compound": "node ./scripts/check-pr-compound-artifacts.js",
    "claims:audit": "node ./scripts/claims-consistency-audit.js",
    "docs:freshness": "node ./scripts/docs-freshness-audit.js",
    "metrics:compound-weekly": "node ./scripts/compound-weekly-report.js",
    "reliability:slo": "node ./scripts/reliability-slo-gate.js",
    "release:hardening": "node ./scripts/release-hardening.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "dogfood:self-host": "node ./scripts/self-host-dogfood.js",
    "self-host:maturity": "node ./scripts/self-host-maturity.js",
    "self-host:provider-backed": "node ./scripts/self-host-provider-backed-report.js",
    "self-host:provider-backed-live": "node ./scripts/self-host-provider-backed-live-report.js",
    "self-host:flake": "node ./scripts/self-host-flake-replay.js",
    "self-host:autonomous": "node ./scripts/self-host-autonomous-report.js",
    "self-host:agent-audit": "node ./scripts/self-host-agent-audit-report.js",
    "self-host:unattended-telemetry": "node ./scripts/self-host-unattended-telemetry-report.js",
    "confidence:publish": "node ./scripts/confidence-tune-publish.js"
  },
  "keywords": [
    "ai",
    "workflow",
    "pipeline",
    "dot",
    "graphviz",
    "agent",
    "orchestration"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhingston/factorial.git"
  },
  "bugs": {
    "url": "https://github.com/mhingston/factorial/issues"
  },
  "homepage": "https://github.com/mhingston/factorial#readme",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "RELEASE.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ai": "^6.0.79",
    "ai-sdk-provider-github": "^0.2.1",
    "async-lock": "^1.4.1",
    "commander": "^12.0.0",
    "dotenv": "^17.2.4",
    "p-limit": "^6.0.0",
    "peggy": "^5.0.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/async-lock": "^1.4.2",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": ">=1.0.0",
    "@ai-sdk/google": ">=1.0.0",
    "@ai-sdk/openai": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    }
  }
}
